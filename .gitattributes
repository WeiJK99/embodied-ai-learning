# 默认：文本文件在仓库中统一以 LF 存储，检出时按平台处理
* text=auto eol=lf

# 显式标记为文本（统一 LF）
*.astro   text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.svelte  text eol=lf
*.css     text eol=lf
*.styl    text eol=lf
*.scss    text eol=lf
*.md      text eol=lf
*.mdx     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.svg     text eol=lf

# 二进制文件：不做换行符转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.mp4     binary
*.webm    binary
*.pdf     binary
